{
  "name": "kaola-header-switcher",
  "version": "1.0.3",
  "private": true,
  "description": "有问题找kaola：按标签页切换请求头的手绘风 Chrome 扩展",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc --project tsconfig.e2e.json --noEmit",
    "build": "pnpm typecheck && node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "package": "pnpm build && node scripts/package.mjs"
  },
  "dependencies": {
    "roughjs": "4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/chrome": "0.2.9",
    "@types/node": "22.20.2",
    "esbuild": "0.28.2",
    "sharp": "0.34.5",
    "typescript": "5.9.3"
  }
}
